# LLM provider for the agent (check current models/limits before use; they change often)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# optional client-side throttle, requests per minute (free tier Flash-Lite: 15)
LLM_RPM=14
# optional, for the eval cost column: USD per 1M tokens (0 / unset = free tier). Check current prices.
LLM_PRICE_IN=
LLM_PRICE_OUT=
